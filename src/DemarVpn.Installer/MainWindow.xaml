<Window x:Class="DemarVpn.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Demar VPN"
        Width="480" Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource DemarBg}"
        WindowStartupLocation="CenterScreen">
  <Border BorderBrush="{StaticResource DemarOutline}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource DemarSurface}"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <TextBlock x:Name="ChromeTitle" Text="Demar VPN" VerticalAlignment="Center"
                   Margin="16,0,0,0" FontSize="13" Foreground="{StaticResource DemarPrimary}" />
        <Button Style="{StaticResource DemarCloseButton}" HorizontalAlignment="Right"
                Width="40" Height="40" Click="Close_OnClick" ToolTip="Закрыть">
          <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource DemarSecondary}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="28,20,28,8" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold"
                   Foreground="{StaticResource DemarPrimary}" Text="Demar VPN" />
        <TextBlock x:Name="SubtitleText" FontSize="13" Opacity="0.85" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource DemarSecondary}" />

        <StackPanel x:Name="PathPanel" Margin="0,20,0,0">
          <TextBlock Text="Папка установки" FontSize="12" Opacity="0.7"
                     Foreground="{StaticResource DemarSecondary}" Margin="0,0,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Height="36" Padding="10,8"
                     Background="{StaticResource DemarSurface}"
                     Foreground="{StaticResource DemarOnPrimaryContainer}"
                     BorderBrush="{StaticResource DemarOutline}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DemarButton}"
                    Content="Обзор…" Margin="8,0,0,0" Height="36" Padding="14,0"
                    Click="Browse_OnClick" />
          </Grid>
        </StackPanel>

        <TextBlock x:Name="StatusText" FontSize="13" Margin="0,16,0,0"
                   Foreground="{StaticResource DemarSecondary}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="28,0,28,24">
        <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True"
                     Visibility="Collapsed" Margin="0,0,0,16" />
        <Button x:Name="ActionButton" Style="{StaticResource DemarButton}"
                Height="44" FontSize="15" FontWeight="SemiBold"
                Click="Action_OnClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
