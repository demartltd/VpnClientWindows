<UserControl
    x:Class="DemarVpn.Controls.DemarSnackbarHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed" HorizontalAlignment="Stretch" IsHitTestVisible="False">
  <Border x:Name="Host" CornerRadius="{StaticResource DemarCornerSmall}" Padding="12" MinHeight="48"
          PointerPressed="OnCopyTap" BorderThickness="0">
    <Grid VerticalAlignment="Center" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="32" />
      </Grid.ColumnDefinitions>
      <FontIcon x:Name="Icon" Grid.Column="0" FontSize="16"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock x:Name="Message" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="2" Click="OnDismiss" Width="32" Height="32" Padding="0"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="Transparent" BorderThickness="0">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent" Width="32" Height="32">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Button.Template>
        <FontIcon Glyph="&#xE711;" FontSize="16" Opacity="0.8" />
      </Button>
    </Grid>
  </Border>
</UserControl>
