<UserControl
    x:Class="DemarVpn.Controls.SupportChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Border x:Name="FloatShadowCast" Background="Transparent" IsHitTestVisible="False" />
      <ScrollViewer x:Name="MsgScroll" Padding="16,8">
        <StackPanel x:Name="MsgHost" />
      </ScrollViewer>
      <ProgressRing x:Name="LoadingRing" Width="36" Height="36" IsActive="False"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
      <!-- Floating chips above composer -->
      <StackPanel VerticalAlignment="Bottom" Spacing="8"
                  Margin="16,0,16,10" Canvas.ZIndex="2">
        <Border x:Name="EditBanner" Visibility="Collapsed"
                Padding="12,8,4,8" CornerRadius="14"
                Background="{StaticResource DemarSurfaceHighBrush}"
                Translation="0,0,16">
          <Border.Shadow>
            <ThemeShadow x:Name="EditShadow" />
          </Border.Shadow>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="28" CornerRadius="2"
                    Background="{StaticResource DemarPrimaryBrush}"
                    VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="EditTitle" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource DemarPrimaryBrush}" />
              <TextBlock x:Name="EditPreview" FontSize="12" Opacity="0.7"
                         TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button Grid.Column="2" Click="OnCancelEdit"
                    Width="36" Height="36" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center">
              <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.7"
                        FontFamily="Segoe Fluent Icons" />
            </Button>
          </Grid>
        </Border>
        <ScrollViewer x:Name="PendingScroll" Visibility="Collapsed" Translation="0,0,16"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Shadow>
            <ThemeShadow x:Name="PendingShadow" />
          </ScrollViewer.Shadow>
          <StackPanel x:Name="PendingHost" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource DemarSurfaceHighBrush}" Padding="12,8,12,12">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="AttachBtn" Content="&#xE16C;" FontFamily="Segoe Fluent Icons"
                MinWidth="52" MinHeight="52" VerticalAlignment="Bottom"
                Click="OnAttach" />
        <TextBox x:Name="InputBox" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="52" MaxHeight="120" VerticalAlignment="Bottom"
                 PreviewKeyDown="OnInputPreviewKeyDown" />
        <Button x:Name="SendBtn" Grid.Column="2" Content="&#xE724;" FontFamily="Segoe Fluent Icons"
                MinWidth="52" MinHeight="52" VerticalAlignment="Bottom"
                Click="OnSend" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
