<UserControl
    x:Class="DemarVpn.Controls.DemarToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center">
  <!-- Clip spacer + On/Off label slot; track is 40×20 (+ vertical margins). -->
  <Grid Width="40" Height="40">
    <Grid.Clip>
      <RectangleGeometry Rect="0,0,40,40" />
    </Grid.Clip>
    <ToggleSwitch x:Name="Inner"
                  MinWidth="0"
                  Padding="0"
                  OnContent="{x:Null}"
                  OffContent="{x:Null}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Toggled="OnInnerToggled" />
  </Grid>
</UserControl>
