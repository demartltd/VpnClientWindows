<UserControl
    x:Class="DemarVpn.Controls.TrafficBottomSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
      <TextBlock x:Name="StatusText" Opacity="0.7" HorizontalAlignment="Center" Visibility="Collapsed" />
      <controls:TrafficPieChart x:Name="Pie" Visibility="Collapsed" />
    </StackPanel>
  </controls:BottomSheetChrome>
</UserControl>
