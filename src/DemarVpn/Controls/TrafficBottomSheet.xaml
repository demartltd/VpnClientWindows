<UserControl
    x:Class="DemarVpn.Controls.TrafficBottomSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap"
                 Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Opacity="0.7" Visibility="Collapsed" />
      <controls:TrafficPieChart x:Name="Pie" Visibility="Collapsed" />
      <Button x:Name="IncreaseButton" Style="{StaticResource DemarAccentButtonStyle}"
              HorizontalAlignment="Stretch" Height="48" Visibility="Collapsed"
              Click="OnIncreaseLimits" />
    </StackPanel>
  </controls:BottomSheetChrome>
</UserControl>
