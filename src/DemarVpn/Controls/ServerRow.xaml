<UserControl
    x:Class="DemarVpn.Controls.ServerRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button x:Name="Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          BorderThickness="1" CornerRadius="{StaticResource DemarCornerSmall}" Padding="16,14"
          Click="OnClick">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Button.Template>
    <Grid ColumnSpacing="12" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}">
        <Image x:Name="FlagImage" Width="26" Height="26" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="TitleBlock" FontWeight="SemiBold" FontSize="15" />
        <TextBlock x:Name="CountryBlock" FontSize="12" Opacity="0.75" />
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
