<UserControl
    x:Class="DemarVpn.Controls.ServerRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls">
  <!-- Hit split 4:1 like Android ServerRow (select | details). -->
  <Border x:Name="Root" BorderThickness="1" CornerRadius="{StaticResource DemarCornerSmall}"
          MinHeight="72">
    <Grid>
      <Grid ColumnSpacing="12" Padding="16,14" VerticalAlignment="Center" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}">
          <Image x:Name="FlagImage" Width="26" Height="26" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon x:Name="FavIcon" Glyph="&#xEB52;" FontSize="12"
                      Foreground="{StaticResource DemarErrorBrush}"
                      Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleBlock" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            <controls:ServerBadge x:Name="TierBadge" VerticalAlignment="Center" />
            <controls:ServerBadge x:Name="ProtoBadge" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="SubtitleBlock" FontSize="12" Opacity="0.75" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <StackPanel x:Name="LatencyPanel" Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="LatencyBlock" FontSize="10" Opacity="0.75" VerticalAlignment="Center" />
            <FontIcon Glyph="&#xE76C;" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
          </StackPanel>
          <Border x:Name="PremiumChip" CornerRadius="8" Padding="10,6"
                  Background="{StaticResource DemarPrimaryBrush}" Visibility="Collapsed"
                  HorizontalAlignment="Right">
            <TextBlock x:Name="PremiumLabel" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource DemarOnPrimaryBrush}" />
          </Border>
        </StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="SelectHit" Style="{StaticResource DemarQuietButtonStyle}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" Padding="0" Click="OnSelectClick" />
        <Button x:Name="TrailingHit" Grid.Column="1" Style="{StaticResource DemarQuietButtonStyle}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" Padding="0" Click="OnTrailingClick" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
