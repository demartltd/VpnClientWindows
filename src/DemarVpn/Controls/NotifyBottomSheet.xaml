<UserControl
    x:Class="DemarVpn.Controls.NotifyBottomSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
  <Grid>
    <Border Background="{StaticResource DemarScrimBrush}" PointerPressed="OnScrimPressed" />
    <Border x:Name="Sheet" VerticalAlignment="Bottom"
            Background="{StaticResource DemarBackgroundBrush}"
            CornerRadius="28,28,0,0" RenderTransformOrigin="0.5,1">
      <Border.RenderTransform>
        <TranslateTransform x:Name="SheetSlide" Y="320" />
      </Border.RenderTransform>
      <StackPanel Padding="24,0,24,28" Spacing="12">
        <Border Width="36" Height="5" CornerRadius="2.5" Margin="0,20,0,8"
                HorizontalAlignment="Center"
                Background="{StaticResource DemarOutlineVariantBrush}" Opacity="0.6" />
        <TextBlock x:Name="LoadingText" Opacity="0.7" HorizontalAlignment="Center" Visibility="Collapsed" />
        <StackPanel x:Name="RowsHost" Spacing="8" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NewsLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch x:Name="NewsSwitch" Grid.Column="1" Toggled="OnNewsToggled" />
          </Grid>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ImportantLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch x:Name="ImportantSwitch" Grid.Column="1" Toggled="OnImportantToggled" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
