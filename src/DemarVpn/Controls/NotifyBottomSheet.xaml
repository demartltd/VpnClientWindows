<UserControl
    x:Class="DemarVpn.Controls.NotifyBottomSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <StackPanel Spacing="8">
      <TextBlock x:Name="LoadingText" Opacity="0.7" HorizontalAlignment="Center" Visibility="Collapsed" />
      <StackPanel x:Name="RowsHost" Spacing="8" Visibility="Collapsed">
        <Border Style="{StaticResource DemarCard}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="ImportantTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="ImportantSub" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <controls:DemarToggle x:Name="ImportantSwitch" Grid.Column="1" Toggled="OnImportantToggled" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="NewsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="NewsSub" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <controls:DemarToggle x:Name="NewsSwitch" Grid.Column="1" Toggled="OnNewsToggled" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </controls:BottomSheetChrome>
</UserControl>
