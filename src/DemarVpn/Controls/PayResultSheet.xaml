<UserControl
    x:Class="DemarVpn.Controls.PayResultSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <StackPanel Spacing="20" HorizontalAlignment="Stretch">
      <FontIcon x:Name="ResultIcon" FontSize="48" HorizontalAlignment="Center" />
      <TextBlock x:Name="ResultText" FontSize="18" FontWeight="SemiBold"
                 TextAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="OkButton" Style="{StaticResource DemarAccentButtonStyle}"
              HorizontalAlignment="Stretch" Height="48" Click="OnOk" />
    </StackPanel>
  </controls:BottomSheetChrome>
</UserControl>
