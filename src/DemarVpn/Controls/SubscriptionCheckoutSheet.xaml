<UserControl
    x:Class="DemarVpn.Controls.SubscriptionCheckoutSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <ScrollViewer MaxHeight="620">
      <StackPanel Spacing="14">
        <!-- Narrow ≈ iOS/Android -->
        <StackPanel x:Name="NarrowPanel" Spacing="14">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NarrowTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" Padding="4" CornerRadius="24" VerticalAlignment="Center"
                    Background="{StaticResource DemarSurfaceHighBrush}">
              <StackPanel x:Name="NarrowCurrency" Orientation="Horizontal" Spacing="4" />
            </Border>
          </Grid>
          <controls:DemarSegmentBar x:Name="TierBar" Height="40" />
          <StackPanel x:Name="PeriodRows" Spacing="6" />
          <StackPanel x:Name="NarrowPriceBlock" Orientation="Horizontal" Spacing="8" />
        </StackPanel>

        <!-- Wide ≈ macOS -->
        <StackPanel x:Name="WidePanel" Spacing="14" Visibility="Collapsed">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Padding="4" CornerRadius="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{StaticResource DemarSurfaceHighBrush}">
              <StackPanel x:Name="PeriodPillsHost" Orientation="Horizontal" Spacing="4"
                          VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Padding="4" CornerRadius="24" VerticalAlignment="Center"
                    Background="{StaticResource DemarSurfaceHighBrush}">
              <StackPanel x:Name="WideCurrency" Orientation="Horizontal" Spacing="4" />
            </Border>
          </Grid>
          <Grid x:Name="PlanCards" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
          </Grid>
        </StackPanel>

        <Button x:Name="PromoButton" Style="{StaticResource DemarQuietButtonStyle}"
                HorizontalAlignment="Left" Click="OnPromoClick" Padding="0,4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{StaticResource DemarPrimaryBrush}" />
            <TextBlock x:Name="PromoLabel" Foreground="{StaticResource DemarPrimaryBrush}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="PlansError" Foreground="{StaticResource DemarErrorBrush}"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="CompareButton" Style="{StaticResource DemarOutlineButtonStyle}"
                  Height="48" HorizontalAlignment="Stretch" Click="OnCompare" />
          <Button x:Name="PayButton" Grid.Column="1" Style="{StaticResource DemarAccentButtonStyle}"
                  Height="48" HorizontalAlignment="Stretch" Click="OnPay" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </controls:BottomSheetChrome>
</UserControl>
