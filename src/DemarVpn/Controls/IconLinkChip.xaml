<UserControl
    x:Class="DemarVpn.Controls.IconLinkChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button x:Name="Root" Click="OnClick" Padding="8" MinWidth="42" MinHeight="42"
          Background="{StaticResource DemarPrimaryMutedBrush}" BorderThickness="0"
          CornerRadius="8">
    <Viewbox Width="26" Height="26">
      <PathIcon x:Name="Icon" Foreground="{StaticResource DemarPrimaryBrush}" />
    </Viewbox>
  </Button>
</UserControl>
