<UserControl
    x:Class="DemarVpn.Controls.IconLinkChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button x:Name="Root" Click="OnClick" Padding="8" MinWidth="42" MinHeight="42"
          Background="{StaticResource DemarPrimaryMutedBrush}" BorderThickness="0"
          CornerRadius="8">
    <Button.Resources>
      <!-- Hover = idle; keep default Pressed animation. -->
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DemarPrimaryMutedBrush" />
      <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DemarPrimaryBrush" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    </Button.Resources>
    <FontIcon x:Name="BrandGlyph" FontSize="26" Foreground="{StaticResource DemarPrimaryBrush}"
              FontFamily="{StaticResource FaBrandsFont}" />
  </Button>
</UserControl>
