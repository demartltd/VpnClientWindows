<UserControl
    x:Class="DemarVpn.Controls.DemarKvRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="KeyColumn" Width="120" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="KeyBlock" Opacity="0.6" TextWrapping="Wrap" />
    <TextBlock x:Name="ValueBlock" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
  </Grid>
</UserControl>
