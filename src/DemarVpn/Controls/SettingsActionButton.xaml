<UserControl
    x:Class="DemarVpn.Controls.SettingsActionButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button x:Name="Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          Background="{StaticResource DemarSurfaceHighBrush}" BorderThickness="0"
          CornerRadius="12" Padding="16" Click="OnClick">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </Button.Template>
    <Grid ColumnSpacing="16" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="IconWell" Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center"
              Background="{StaticResource DemarPrimaryMutedBrush}" CornerRadius="8">
        <FontIcon x:Name="Icon" FontSize="24" Foreground="{StaticResource DemarPrimaryBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
        <!-- titleLeading UnreadDot — primary, before title -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse x:Name="UnreadDot" Width="8" Height="8"
                   Fill="{StaticResource DemarPrimaryBrush}"
                   VerticalAlignment="Center" Visibility="Collapsed" />
          <TextBlock x:Name="TitleBlock" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="SubtitleBlock" Opacity="0.7" TextWrapping="Wrap" />
        <ProgressBar x:Name="UsageBar" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Margin="0,4,0,0" />
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16" Opacity="0.7" VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
