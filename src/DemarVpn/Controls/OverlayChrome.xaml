<UserControl
    x:Class="DemarVpn.Controls.OverlayChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="{StaticResource OverlayHeaderPadding}"
          ColumnSpacing="{StaticResource OverlayHeaderColumnSpacing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Click="OnBack" Content="←" />
      <TextBlock x:Name="TitleBlock" Grid.Column="1"
                 Style="{StaticResource OverlayTitleStyle}" />
    </Grid>
    <ContentPresenter x:Name="BodyHost" Grid.Row="1" />
  </Grid>
</UserControl>
