<UserControl
    x:Class="DemarVpn.Controls.LoginBottomSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    xmlns:local="using:DemarVpn.Controls"
    x:DataType="local:LoginBottomSheet"
    Visibility="Collapsed">
  <Grid>
    <Border Background="{StaticResource DemarScrimBrush}" PointerPressed="OnScrimPressed" />
    <Border x:Name="Sheet" VerticalAlignment="Bottom"
            Background="{StaticResource DemarBackgroundBrush}"
            CornerRadius="28,28,0,0" RenderTransformOrigin="0.5,1">
      <Border.RenderTransform>
        <TranslateTransform x:Name="SheetSlide" Y="400" />
      </Border.RenderTransform>
      <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,0,24,28" Spacing="16">
          <TextBlock x:Name="StepTitle" Style="{StaticResource DemarTabTitleStyle}"
                     FontSize="22" Margin="0,24,0,24" TextWrapping="Wrap" TextAlignment="Center" />
          <StackPanel x:Name="EmailStep" Spacing="12">
            <Border Background="{StaticResource DemarSurfaceHighBrush}"
                    BorderBrush="{StaticResource DemarOutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="8" MinHeight="52">
              <TextBox x:Name="EmailBox" Style="{StaticResource DemarPlainTextBoxStyle}"
                       PlaceholderText="{x:Bind EmailHint, Mode=OneTime}" />
            </Border>
            <Button Style="{StaticResource DemarAccentButtonStyle}"
                    Content="{x:Bind ContinueText, Mode=OneTime}" Click="OnEmailContinue" />
          </StackPanel>
          <StackPanel x:Name="VerifyStep" Visibility="Collapsed" Spacing="16">
            <controls:OtpInput x:Name="VerifyOtp" Completed="OnVerifyComplete" HorizontalAlignment="Center" />
            <HyperlinkButton Content="{x:Bind ResendText, Mode=OneTime}" Click="OnResend" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel x:Name="TotpStep" Visibility="Collapsed" Spacing="16">
            <controls:OtpInput x:Name="TotpOtp" Completed="OnTotpComplete" HorizontalAlignment="Center" />
          </StackPanel>
          <Grid ColumnSpacing="12" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="1" VerticalAlignment="Center" Background="{StaticResource DemarOutlineVariantBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind MoreMethodsText, Mode=OneTime}" Opacity="0.6" FontSize="12" />
            <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{StaticResource DemarOutlineVariantBrush}" />
          </Grid>
          <controls:IconLinkChip x:Name="TelegramChip" HorizontalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
