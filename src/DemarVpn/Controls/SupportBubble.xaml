<UserControl
    x:Class="DemarVpn.Controls.SupportBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" MaxWidth="284" Margin="0,0,0,8">
    <Border x:Name="BubbleBorder" Padding="10" CornerRadius="16"
            ContextRequested="OnContextRequested">
      <StackPanel Spacing="6">
        <TextBlock x:Name="BodyBlock" TextWrapping="Wrap" IsTextSelectionEnabled="False"
                   Visibility="Collapsed" ContextFlyout="{x:Null}" />
        <StackPanel x:Name="MediaHost" />
        <TextBlock x:Name="TimeBlock" FontSize="10" Opacity="0.55" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
