<UserControl
    x:Class="DemarVpn.Controls.ServerDetailsSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls"
    Visibility="Collapsed">
  <controls:BottomSheetChrome x:Name="Chrome">
    <StackPanel Spacing="0">
      <Grid ColumnSpacing="12" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}">
          <Image x:Name="FlagImage" Width="26" Height="26" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="NameBlock" Grid.Column="1" FontSize="22" FontWeight="Bold"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="FavButton" Grid.Column="2" Style="{StaticResource DemarQuietButtonStyle}"
                Width="40" Height="40" Padding="0" Background="Transparent" Click="OnFavClick"
                VerticalAlignment="Center">
          <FontIcon x:Name="FavIcon" Glyph="&#xEB51;" FontSize="28"
                    Foreground="{StaticResource DemarSecondaryBrush}" />
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,16">
        <controls:ServerBadge x:Name="TierBadge" Large="True" />
        <controls:ServerBadge x:Name="ProtoBadge" Large="True" />
      </StackPanel>
      <Border Background="{StaticResource DemarSurfaceHighBrush}" CornerRadius="16">
        <StackPanel x:Name="MetricsHost" />
      </Border>
    </StackPanel>
  </controls:BottomSheetChrome>
</UserControl>
