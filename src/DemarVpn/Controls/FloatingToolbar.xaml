<UserControl
    x:Class="DemarVpn.Controls.FloatingToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="LayoutRoot" ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="64" />
    </Grid.ColumnDefinitions>
    <Border x:Name="MainShell" Grid.Column="0" Style="{StaticResource DemarToolbarShellStyle}" Padding="4">
      <Grid x:Name="MainTabGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="MainIndicator" Grid.Column="0"
                Background="{StaticResource DemarPrimaryContainerBrush}" CornerRadius="24" />
        <ToggleButton x:Name="Tab0" Grid.Column="0" Style="{StaticResource FloatingTabButtonStyle}" Click="OnTabClick" Tag="0">
          <FontIcon Glyph="&#xE72E;" />
        </ToggleButton>
        <ToggleButton x:Name="Tab1" Grid.Column="1" Style="{StaticResource FloatingTabButtonStyle}" Click="OnTabClick" Tag="1">
          <FontIcon Glyph="&#xE774;" />
        </ToggleButton>
        <ToggleButton x:Name="Tab2" Grid.Column="2" Style="{StaticResource FloatingTabButtonStyle}" Click="OnTabClick" Tag="2">
          <FontIcon Glyph="&#xE713;" />
        </ToggleButton>
      </Grid>
    </Border>
    <Border x:Name="AccountShell" Grid.Column="1" Style="{StaticResource DemarToolbarShellStyle}" Width="64">
      <ToggleButton x:Name="Tab3" Style="{StaticResource FloatingTabButtonStyle}" Click="OnTabClick" Tag="3">
        <FontIcon Glyph="&#xE77B;" />
      </ToggleButton>
    </Border>
  </Grid>
</UserControl>
