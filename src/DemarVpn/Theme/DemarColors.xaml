<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Fallback until DemarPalette.Apply(); replaced at startup from seed #3A6EA5 TonalSpot dark -->
  <Color x:Key="DemarSeedColor">#FF3A6EA5</Color>
  <SolidColorBrush x:Key="DemarSeedBrush" Color="{StaticResource DemarSeedColor}" />
  <SolidColorBrush x:Key="DemarBackgroundBrush" Color="#FF121820" />
  <SolidColorBrush x:Key="DemarSurfaceBrush" Color="#FF1A222C" />
  <SolidColorBrush x:Key="DemarSurfaceHighBrush" Color="#FF252E3A" />
  <SolidColorBrush x:Key="DemarPrimaryBrush" Color="#FFA5C8FF" />
  <SolidColorBrush x:Key="DemarOnPrimaryBrush" Color="#FF00315C" />
  <SolidColorBrush x:Key="DemarPrimaryContainerBrush" Color="#FF2A4A6E" />
  <SolidColorBrush x:Key="DemarOnPrimaryContainerBrush" Color="#FFD8E8F8" />
  <SolidColorBrush x:Key="DemarSecondaryBrush" Color="#FFB8C8DA" />
  <SolidColorBrush x:Key="DemarTertiaryBrush" Color="#FFC8B8E8" />
  <SolidColorBrush x:Key="DemarOnTertiaryBrush" Color="#FF3D2A5C" />
  <SolidColorBrush x:Key="DemarErrorBrush" Color="#FFFFB4AB" />
  <SolidColorBrush x:Key="DemarSuccessBrush" Color="#FF81C784" />
  <SolidColorBrush x:Key="DemarWarningBrush" Color="#FFFFB74D" />
  <SolidColorBrush x:Key="DemarPrimaryMutedBrush" Color="#1A3A6EA5" />
  <SolidColorBrush x:Key="DemarSuccessMutedBrush" Color="#33B8C8DA" />
  <SolidColorBrush x:Key="DemarErrorMutedBrush" Color="#33FFB4AB" />
  <SolidColorBrush x:Key="DemarOutlineBrush" Color="#FFB8C8DA" />
  <SolidColorBrush x:Key="DemarOutlineVariantBrush" Color="#FF4A5564" />
  <SolidColorBrush x:Key="DemarScrimBrush" Color="#CC000000" />

  <CornerRadius x:Key="DemarCornerSmall">12</CornerRadius>
  <CornerRadius x:Key="DemarCornerMedium">14</CornerRadius>
  <CornerRadius x:Key="DemarCornerLarge">16</CornerRadius>
  <x:Double x:Key="ToolbarHeight">64</x:Double>
  <x:Double x:Key="ToolbarVerticalGap">16</x:Double>
  <x:Double x:Key="AppMinWidth">400</x:Double>
  <x:Double x:Key="AppMinHeight">560</x:Double>
  <x:Double x:Key="AppDefaultWidth">480</x:Double>
  <x:Double x:Key="AppDefaultHeight">700</x:Double>
  <x:Double x:Key="ToolbarWideBreakpoint">800</x:Double>
  <x:Double x:Key="ToolbarTabWidth">168</x:Double>
  <Thickness x:Key="ToolbarChromeMargin">16,16,16,16</Thickness>
  <Thickness x:Key="ToolbarSnackbarMargin">16,0,16,104</Thickness>
  <Thickness x:Key="SnackbarOverlayMargin">16,0,16,16</Thickness>
  <Thickness x:Key="TabScrollPadding">16,8,16,0</Thickness>
  <Thickness x:Key="OverlayHeaderPadding">8</Thickness>
  <x:Double x:Key="OverlayHeaderColumnSpacing">8</x:Double>
  <Thickness x:Key="OverlayBodyPadding">16</Thickness>
  <FontFamily x:Key="FaBrandsFont">ms-appx:///Assets/Fonts/fa-brands-400.ttf#Font Awesome 6 Brands</FontFamily>
</ResourceDictionary>
