<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="DemarColors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style TargetType="Page">
    <Setter Property="Background" Value="{StaticResource DemarBackgroundBrush}" />
  </Style>

  <Style x:Key="DemarTitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style x:Key="DemarCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DemarSurfaceHighBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource DemarCornerMedium}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="SettingsRowStyle" TargetType="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource DemarSurfaceHighBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>
</ResourceDictionary>
