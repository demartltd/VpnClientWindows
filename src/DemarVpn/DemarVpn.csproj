<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DemarVpn</RootNamespace>
    <AssemblyName>Demar VPN</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.10</AssemblyVersion>
    <FileVersion>1.0.9.10</FileVersion>
    <ApplicationTitle>Demar VPN</ApplicationTitle>
    <ApplicationDescription>Demar VPN / Best VPN</ApplicationDescription>
    <SatelliteResourceLanguages>en-US;ru-RU</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <LibboxPkg>$(MSBuildProjectDirectory)\Native\packages\SagerNet.Libbox.0.0.0-local.nupkg</LibboxPkg>
    <HasLibbox Condition="Exists('$(LibboxPkg)')">true</HasLibbox>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HasLibbox)' == 'true'">
    <DefineConstants>$(DefineConstants);HAS_LIBBOX</DefineConstants>
    <RestoreAdditionalProjectSources>$(MSBuildProjectDirectory)\Native\packages;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="SagerNet.Libbox" Version="0.0.0-local" Condition="'$(HasLibbox)' == 'true'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(HasLibbox)' == 'true'">
    <Content Include="Native\runtimes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\bin\sing-box.exe" Condition="Exists('Native\bin\sing-box.exe')">
      <Link>sing-box.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\bin\wintun.dll" Condition="Exists('Native\bin\wintun.dll')">
      <Link>wintun.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\bin\libcronet.dll" Condition="Exists('Native\bin\libcronet.dll')">
      <Link>libcronet.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
