<local:OverlayPage
    x:Class="DemarVpn.Views.ServiceMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
  <controls:OverlayChrome x:Name="Chrome">
    <ScrollViewer Padding="{StaticResource OverlayBodyPadding}">
      <StackPanel Spacing="12">
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock x:Name="AboutHeader" FontWeight="SemiBold" />
            <controls:DemarKvRow x:Name="NameRow" />
            <controls:DemarKvRow x:Name="PackageRow" />
            <controls:DemarKvRow x:Name="VersionRow" />
            <controls:DemarKvRow x:Name="LatestVersionRow" />
            <controls:DemarKvRow x:Name="PlatformRow" />
            <controls:DemarKvRow x:Name="CoreRow" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock x:Name="InternetHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="RefreshBtn" HorizontalAlignment="Right" Click="OnEgressRefresh">
                <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" RenderTransformOrigin="0.5,0.5">
                  <FontIcon.RenderTransform>
                    <RotateTransform x:Name="RefreshSpin" Angle="0" />
                  </FontIcon.RenderTransform>
                </FontIcon>
              </Button>
            </Grid>
            <controls:DemarKvRow x:Name="RouteRow" Value="…" />
            <controls:DemarKvRow x:Name="IpRow" Value="…" />
            <controls:DemarKvRow x:Name="CountryRow" Value="…" />
            <StackPanel x:Name="HostRowsPanel" Spacing="8" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock x:Name="DeviceHeader" FontWeight="SemiBold" />
            <ProgressRing x:Name="DeviceBusy" Width="24" Height="24" HorizontalAlignment="Center" IsActive="True" />
            <StackPanel x:Name="DevicePanel" Spacing="8" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock Text="Snack bar" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Info" Click="OnSnackInfo" />
              <Button Content="OK" Click="OnSnackSuccess" />
              <Button Content="Err" Click="OnSnackError" />
              <Button Content="Warn" Click="OnSnackWarning" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="12">
            <TextBlock x:Name="InfoSheetsHeader" FontWeight="SemiBold" />
            <controls:SettingsActionButton x:Name="ExpiryBtn" Glyph="&#xE787;" Click="OnInfoExpiry" />
            <controls:SettingsActionButton x:Name="FreeTrafficBtn" Glyph="&#xE9D9;" Click="OnInfoFreeTraffic" />
            <controls:SettingsActionButton x:Name="TrafficBtn" Glyph="&#xE9D9;" Click="OnInfoTraffic" />
            <controls:SettingsActionButton x:Name="PayOkBtn" Glyph="&#xE73E;" Click="OnInfoPayOk" />
            <controls:SettingsActionButton x:Name="PayFailBtn" Glyph="&#xE711;" Click="OnInfoPayFail" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock x:Name="DebugHeader" FontWeight="SemiBold" />
            <Button x:Name="RestartBtn" Click="OnRestartCore" HorizontalAlignment="Stretch" />
            <Button x:Name="CrashBtn" Click="OnCrash" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </controls:OverlayChrome>
</local:OverlayPage>
