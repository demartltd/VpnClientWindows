<local:OverlayPage
    x:Class="DemarVpn.Views.ServiceMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DemarVpn.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Click="OnBack" Content="←" />
      <TextBlock Grid.Column="1" Text="Service menu" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16">
      <StackPanel Spacing="12">
        <Border Style="{StaticResource DemarCard}">
          <StackPanel x:Name="AboutPanel" Spacing="6" />
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock Text="Egress (mock)" FontWeight="SemiBold" />
            <TextBlock x:Name="EgressStatus" Opacity="0.7" />
            <Button Content="Refresh" Click="OnEgressRefresh" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="6">
            <TextBlock Text="Device identity (mock)" FontWeight="SemiBold" />
            <TextBlock Text="device_id: win-demo-001" FontFamily="Consolas" />
            <TextBlock Text="install_id: mock-install" FontFamily="Consolas" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock Text="Snack bar" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Info" Click="OnSnackInfo" />
              <Button Content="Success" Click="OnSnackSuccess" />
              <Button Content="Error" Click="OnSnackError" />
              <Button Content="Warning" Click="OnSnackWarning" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</local:OverlayPage>
