<Page
    x:Class="DemarVpn.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls">
  <Grid Padding="{StaticResource TabScrollPadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="ShadowCast" Grid.RowSpan="5" Background="Transparent" IsHitTestVisible="False" />
    <TextBlock x:Name="TitleBlock" Style="{StaticResource DemarTitleText}" />
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="14">
      <Button x:Name="Toggle" Style="{StaticResource DemarAccentButtonStyle}"
              Width="200" Height="200" MinHeight="0" Padding="0" CornerRadius="100"
              Click="OnToggle" Background="{StaticResource DemarSurfaceHighBrush}" BorderThickness="0">
        <Grid>
          <FontIcon x:Name="ToggleIcon" Glyph="&#xE7E8;" FontSize="72" />
          <ProgressRing x:Name="BusyRing" Width="46" Height="46"
                        IsActive="False" Visibility="Collapsed" />
        </Grid>
      </Button>
      <TextBlock x:Name="ConnectedLabel" Visibility="Collapsed"
                 Foreground="{StaticResource DemarSeedBrush}" FontWeight="Bold" FontSize="18"
                 HorizontalAlignment="Center" />
    </StackPanel>
    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Spacing="6" Margin="0,20,0,0">
      <TextBlock x:Name="ServerEmpty" FontSize="16" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Visibility="Collapsed" />
      <Button x:Name="ServerCard" Style="{StaticResource DemarQuietButtonStyle}"
              Background="Transparent" Padding="12,6" CornerRadius="16"
              Click="OnServerCardClick" HorizontalAlignment="Center"
              HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}"
                  VerticalAlignment="Center">
            <Image x:Name="FlagImage" Width="26" Height="26" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" MaxWidth="120" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="ServerTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
            <TextBlock x:Name="ServerCity" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
          </StackPanel>
          <Border Grid.Column="2" Width="1" Height="52" Margin="12,0"
                  Background="{StaticResource DemarOutlineBrush}" Opacity="0.35" />
          <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center"
                      HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
              <Grid x:Name="FavBadge" Width="24" Height="24" Visibility="Collapsed">
                <Border CornerRadius="6" Background="{StaticResource DemarErrorBrush}" Opacity="0.16" />
                <FontIcon Glyph="&#xEB52;" FontSize="12" Foreground="{StaticResource DemarErrorBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <controls:ServerBadge x:Name="TierBadge" Large="True" />
            </StackPanel>
            <controls:ServerBadge x:Name="ProtoBadge" Large="True" />
          </StackPanel>
        </Grid>
      </Button>
      <TextBlock x:Name="Throughput" HorizontalAlignment="Center" Opacity="0.8" />
    </StackPanel>
    <Border x:Name="UpdateFab" Grid.RowSpan="5"
            Width="64" Height="64"
            Background="{StaticResource DemarOnTertiaryBrush}"
            CornerRadius="20"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,0,8" Canvas.ZIndex="10"
            Translation="0,0,32"
            Visibility="Collapsed">
      <Border.Shadow>
        <ThemeShadow x:Name="UpdateShadow" />
      </Border.Shadow>
      <Button x:Name="UpdateButton" Click="OnUpdateFabClick"
              Background="Transparent" BorderThickness="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              CornerRadius="20" Padding="0">
        <Grid>
          <FontIcon x:Name="UpdateIcon" Glyph="&#xE72C;" FontSize="20"
                    Foreground="{StaticResource DemarTertiaryBrush}" />
          <StackPanel x:Name="UpdateProgressPanel" Spacing="0"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
            <TextBlock x:Name="UpdatePercent" Text="0%" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource DemarTertiaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="UpdateHint" FontSize="9" Opacity="0.85"
                       Foreground="{StaticResource DemarTertiaryBrush}"
                       HorizontalAlignment="Center" TextWrapping="NoWrap" />
          </StackPanel>
        </Grid>
      </Button>
    </Border>
  </Grid>
</Page>
