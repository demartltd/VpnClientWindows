<Page
    x:Class="DemarVpn.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="{StaticResource TabScrollPadding}">
    <Grid x:Name="ShadowCast" Background="Transparent" IsHitTestVisible="False" />
    <ScrollViewer VerticalScrollMode="Enabled">
      <StackPanel x:Name="ListHost" Spacing="10" Padding="0,4,0,148" />
    </ScrollViewer>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,0,8" Spacing="12" Canvas.ZIndex="10">
      <Border x:Name="FilterFab"
              Width="32" Height="32"
              HorizontalAlignment="Right"
              Background="{StaticResource DemarSurfaceHighBrush}"
              CornerRadius="10"
              Translation="0,0,32">
        <Border.Shadow>
          <ThemeShadow x:Name="FilterShadow" />
        </Border.Shadow>
        <Button x:Name="FilterButton" Style="{StaticResource DemarQuietButtonStyle}"
                Click="OnFilterClick"
                Background="Transparent" Padding="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="10">
          <FontIcon x:Name="FilterIcon" Glyph="&#xE90F;" FontSize="12"
                    Foreground="{StaticResource DemarSecondaryBrush}" />
        </Button>
      </Border>
      <Border x:Name="RefreshFab"
              Width="64" Height="64"
              HorizontalAlignment="Right"
              Background="{StaticResource DemarOnTertiaryBrush}"
              CornerRadius="20"
              Translation="0,0,32">
        <Border.Shadow>
          <ThemeShadow x:Name="RefreshShadow" />
        </Border.Shadow>
        <Button x:Name="RefreshButton" Style="{StaticResource DemarQuietButtonStyle}"
                Click="OnRefreshClick"
                Background="Transparent" Padding="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                CornerRadius="20">
          <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="20"
                    Foreground="{StaticResource DemarTertiaryBrush}"
                    RenderTransformOrigin="0.5,0.5">
            <FontIcon.RenderTransform>
              <RotateTransform x:Name="RefreshIconRotate" />
            </FontIcon.RenderTransform>
          </FontIcon>
        </Button>
      </Border>
    </StackPanel>
  </Grid>
</Page>
