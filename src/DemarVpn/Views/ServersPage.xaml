<Page
    x:Class="DemarVpn.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls">
  <Grid Padding="{StaticResource TabScrollPadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="ShadowCast" Grid.RowSpan="2" Background="Transparent" IsHitTestVisible="False" />
    <StackPanel Spacing="12" Margin="0,4,0,0">
      <controls:DemarSegmentBar x:Name="ProtocolBar" Bold="True" />
      <controls:DemarSegmentBar x:Name="TierBar" />
      <Border Height="1"
              Background="{StaticResource DemarOutlineVariantBrush}" Opacity="0.6" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ListHost" Spacing="10" Padding="0,12,0,80" />
    </ScrollViewer>
    <Border x:Name="RefreshFab" Grid.Row="1"
            Width="64" Height="64"
            Background="{StaticResource DemarOnTertiaryBrush}"
            CornerRadius="20"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,0,8" Canvas.ZIndex="10"
            Translation="0,0,32">
      <Border.Shadow>
        <ThemeShadow x:Name="RefreshShadow" />
      </Border.Shadow>
      <Button x:Name="RefreshButton" Click="OnRefreshClick"
              Background="Transparent" BorderThickness="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              CornerRadius="20" Padding="0">
        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="20"
                  Foreground="{StaticResource DemarTertiaryBrush}"
                  RenderTransformOrigin="0.5,0.5">
          <FontIcon.RenderTransform>
            <RotateTransform x:Name="RefreshIconRotate" />
          </FontIcon.RenderTransform>
        </FontIcon>
      </Button>
    </Border>
  </Grid>
</Page>
