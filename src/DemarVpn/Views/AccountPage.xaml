<Page
    x:Class="DemarVpn.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DemarVpn.Controls">
  <ScrollViewer Padding="{StaticResource TabScrollPadding}">
    <StackPanel Spacing="12" Padding="0,0,0,20">
      <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,56,0,0">
        <FontIcon Glyph="&#xE77B;" FontSize="64" Foreground="{StaticResource DemarPrimaryBrush}"
                  HorizontalAlignment="Center" />
        <TextBlock x:Name="UserName" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="UserIdButton" Style="{StaticResource DemarQuietButtonStyle}"
                HorizontalAlignment="Center" Click="OnCopyId">
          <TextBlock x:Name="UserIdText" Opacity="0.7" TextAlignment="Center" />
        </Button>
      </StackPanel>

      <Border x:Name="SubCard" CornerRadius="12" Padding="16" Margin="0,20,0,0"
              BorderBrush="{StaticResource DemarOutlineVariantBrush}" BorderThickness="1" Background="Transparent">
        <Grid>
          <ProgressRing x:Name="SubLoading" Width="32" Height="32" IsActive="False" Visibility="Collapsed"
                        HorizontalAlignment="Center" />
          <StackPanel x:Name="SubBody" Spacing="12">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}">
                <FontIcon Glyph="&#xE734;" FontSize="24" Foreground="{StaticResource DemarPrimaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PlanLabel" FontWeight="SemiBold" />
                <TextBlock x:Name="PlanValue" Opacity="0.7" FontSize="12" />
              </StackPanel>
            </Grid>
            <Grid x:Name="ExpiresRow" ColumnSpacing="16" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource DemarPrimaryMutedBrush}">
                <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{StaticResource DemarPrimaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ExpiresLabel" FontWeight="SemiBold" />
                <TextBlock x:Name="ExpiresValue" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Button x:Name="PurchaseButton" Style="{StaticResource DemarAccentButtonStyle}"
                    HorizontalAlignment="Stretch" Height="48" Click="OnPurchase" />
          </StackPanel>
        </Grid>
      </Border>

      <controls:SettingsActionButton x:Name="TrafficRow" Glyph="&#xE9D9;" Click="OnTraffic" />
      <Border CornerRadius="12" Padding="16" BorderBrush="{StaticResource DemarOutlineVariantBrush}"
              BorderThickness="1" Background="Transparent" Tapped="OnFamily">
        <StackPanel Spacing="4">
          <TextBlock x:Name="FamilyTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="FamilySub" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
          <Grid Margin="0,8,0,0" Background="{StaticResource DemarSurfaceHighBrush}"
                CornerRadius="12" Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
              <TextBlock x:Name="FamilyFree" Opacity="0.7" FontSize="12" />
              <StackPanel x:Name="FamilySlots" Orientation="Horizontal" Spacing="8" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="20" Padding="14,8"
                    Background="{StaticResource DemarPrimaryMutedBrush}" VerticalAlignment="Center">
              <TextBlock x:Name="FamilyChange" Foreground="{StaticResource DemarPrimaryBrush}" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </StackPanel>
      </Border>
      <controls:SettingsActionButton x:Name="NotifyRow" Glyph="&#xEA8F;" Click="OnNotify" />
      <controls:SettingsActionButton x:Name="SignOutRow" Glyph="&#xF3B1;" Click="OnSignOutClick" />
    </StackPanel>
  </ScrollViewer>
</Page>
