<Page
    x:Class="DemarVpn.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="{StaticResource TabScrollPadding}">
    <StackPanel Spacing="16">
      <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource DemarTabTitleStyle}" />
      <Border Style="{StaticResource DemarCard}">
        <StackPanel Spacing="6">
          <TextBlock x:Name="UserName" FontWeight="SemiBold" FontSize="18" />
          <TextBlock x:Name="UserId" Opacity="0.7" />
          <TextBlock x:Name="UserVpn" />
          <TextBlock x:Name="UserExpires" Opacity="0.7" />
        </StackPanel>
      </Border>
      <Button Content="{x:Bind SignOutLabel, Mode=OneTime}" Click="OnSignOut" HorizontalAlignment="Stretch" />
    </StackPanel>
  </ScrollViewer>
</Page>
