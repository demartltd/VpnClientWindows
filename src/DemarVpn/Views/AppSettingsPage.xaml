<local:OverlayPage
    x:Class="DemarVpn.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls">
  <controls:OverlayChrome x:Name="Chrome">
    <ScrollViewer Padding="{StaticResource OverlayBodyPadding}">
      <StackPanel Spacing="12">
        <Border Style="{StaticResource DemarCard}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="StartupTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="StartupSub" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <controls:DemarToggle x:Name="StartupToggle" Grid.Column="1" Toggled="OnStartupToggled" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="BetaTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="BetaSub" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <controls:DemarToggle x:Name="BetaToggle" Grid.Column="1" Toggled="OnBetaToggled" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="8">
            <TextBlock Text="Журнал" FontWeight="SemiBold" />
            <TextBlock Text="Сообщения приложения и ядра VPN" Opacity="0.7" TextWrapping="Wrap" />
            <Button x:Name="ExpandBtn" Click="OnExpand" HorizontalAlignment="Left" />
            <Border x:Name="JournalBox" Visibility="Collapsed" Height="260" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <TextBlock x:Name="JournalEmpty" Text="Пока пусто" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ScrollViewer x:Name="JournalScroll" Padding="8">
                  <TextBlock x:Name="JournalText" FontFamily="Consolas" FontSize="12"
                             IsTextSelectionEnabled="True" TextWrapping="Wrap"
                             MaxWidth="{Binding ViewportWidth, ElementName=JournalScroll}" />
                </ScrollViewer>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Очистить" Click="OnClear" />
              <Button Content="Поделиться" Click="OnShare" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </controls:OverlayChrome>
</local:OverlayPage>
