<local:OverlayPage
    x:Class="DemarVpn.Views.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DemarVpn.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Click="OnBack" Content="←" />
      <TextBlock Grid.Column="1" Text="Настройки приложения" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16">
      <StackPanel Spacing="12">
        <Border Style="{StaticResource DemarCard}">
          <StackPanel Spacing="12">
            <TextBlock Text="Журнал" FontWeight="SemiBold" />
            <TextBlock Text="Сообщения приложения и ядра VPN" Opacity="0.7" TextWrapping="Wrap" />
            <Button x:Name="ExpandBtn" Click="OnExpand" HorizontalAlignment="Left" />
            <Border x:Name="JournalBox" Visibility="Collapsed" Height="260" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
              <Grid>
                <TextBlock x:Name="JournalEmpty" Text="Пока пусто" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ScrollViewer x:Name="JournalScroll" Padding="8">
                  <TextBlock x:Name="JournalText" FontFamily="Consolas" FontSize="12"
                             IsTextSelectionEnabled="True" TextWrapping="Wrap"
                             MaxWidth="{Binding ViewportWidth, ElementName=JournalScroll}" />
                </ScrollViewer>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Очистить" Click="OnClear" />
              <Button Content="Поделиться" Click="OnShare" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</local:OverlayPage>
