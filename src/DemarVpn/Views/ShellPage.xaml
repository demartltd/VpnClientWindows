<Page
    x:Class="DemarVpn.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="MainLayer" Grid.Row="0">
      <views:HomePage x:Name="HomeTab" Visibility="Visible" />
      <views:ServersPage x:Name="ServersTab" Visibility="Collapsed" />
      <views:SettingsPage x:Name="SettingsTab" Visibility="Collapsed" />
      <views:AccountPage x:Name="AccountTab" Visibility="Collapsed" />
    </Grid>
    <Frame x:Name="OverlayFrame" Grid.RowSpan="2" Visibility="Collapsed" x:FieldModifier="public" Canvas.ZIndex="500" />
    <Grid x:Name="BottomChrome" Grid.Row="1" Margin="{StaticResource ToolbarChromeMargin}" Canvas.ZIndex="1000">
      <controls:FloatingToolbar x:Name="Toolbar" Height="64" VerticalAlignment="Bottom" SelectionChanged="OnTabChanged" />
      <controls:DemarSnackbarHost x:Name="Snackbar" VerticalAlignment="Bottom" Margin="{StaticResource ToolbarSnackbarMargin}" HorizontalAlignment="Stretch" />
    </Grid>
  </Grid>
</Page>
