<Page
    x:Class="DemarVpn.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="MainLayer" Grid.Row="0">
      <views:HomePage x:Name="HomeTab" Visibility="Visible" />
      <views:ServersPage x:Name="ServersTab" Visibility="Collapsed" />
      <views:SettingsPage x:Name="SettingsTab" Visibility="Collapsed" />
      <views:AccountPage x:Name="AccountTab" Visibility="Collapsed" />
    </Grid>
    <Frame x:Name="OverlayFrame" Grid.RowSpan="2" Visibility="Collapsed" x:FieldModifier="public" Canvas.ZIndex="500" />
    <Grid x:Name="BottomChrome" Grid.Row="1" Margin="{StaticResource ToolbarChromeMargin}" Canvas.ZIndex="1000">
      <controls:FloatingToolbar x:Name="Toolbar" Height="64" VerticalAlignment="Bottom" SelectionChanged="OnTabChanged" />
    </Grid>
    <controls:DemarSnackbarHost x:Name="Snackbar" Grid.RowSpan="2" Canvas.ZIndex="2000"
                                VerticalAlignment="Bottom" Margin="{StaticResource ToolbarSnackbarMargin}"
                                HorizontalAlignment="Stretch" />
    <controls:LoginBottomSheet x:Name="LoginSheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:DocumentsBottomSheet x:Name="DocumentsSheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:NotifyBottomSheet x:Name="NotifySheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:TrafficBottomSheet x:Name="TrafficSheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:ServerFiltersSheet x:Name="FiltersSheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:ServerDetailsSheet x:Name="ServerDetailsSheet" Grid.RowSpan="2" Canvas.ZIndex="1500" />
    <controls:SubscriptionInfoSheet x:Name="InfoSheet" Grid.RowSpan="2" Canvas.ZIndex="1600" />
    <controls:SubscriptionCheckoutSheet x:Name="CheckoutSheet" Grid.RowSpan="2" Canvas.ZIndex="1600" />
    <controls:PlanCompareSheet x:Name="CompareSheet" Grid.RowSpan="2" Canvas.ZIndex="1600" />
    <controls:PayResultSheet x:Name="PayResultSheet" Grid.RowSpan="2" Canvas.ZIndex="1700" />
  </Grid>
</Page>
