<Page
    x:Class="DemarVpn.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls">
  <Grid>
    <Grid x:Name="MainLayer" Padding="{StaticResource FloatingToolbarInset}">
      <views:HomePage x:Name="HomeTab" Visibility="Visible" />
      <views:ServersPage x:Name="ServersTab" Visibility="Collapsed" />
      <views:SettingsPage x:Name="SettingsTab" Visibility="Collapsed" />
      <views:AccountPage x:Name="AccountTab" Visibility="Collapsed" />
    </Grid>
    <Frame x:Name="OverlayFrame" Visibility="Collapsed" x:FieldModifier="public" />
    <Grid x:Name="BottomChrome" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
          Margin="{StaticResource FloatingToolbarMargin}" Canvas.ZIndex="1000">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:DemarSnackbarHost x:Name="Snackbar" Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
      <controls:FloatingToolbar x:Name="Toolbar" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="OnTabChanged" />
    </Grid>
  </Grid>
</Page>
