<local:OverlayPage
    x:Class="DemarVpn.Views.DocumentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DemarVpn.Views"
    xmlns:controls="using:DemarVpn.Controls">
  <controls:OverlayChrome x:Name="Chrome">
    <Grid>
      <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ScrollViewer x:Name="ContentScroll" Visibility="Collapsed"
                    Padding="{StaticResource OverlayBodyPadding}"
                    HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="BlocksHost" HorizontalAlignment="Stretch" Spacing="0"
                    Width="{Binding ViewportWidth, ElementName=ContentScroll}" />
      </ScrollViewer>
    </Grid>
  </controls:OverlayChrome>
</local:OverlayPage>
